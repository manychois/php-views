{
  "name": "manychois/views",
  "description": "A simple PHP template library based on DOM manipulations.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Siu Pang Tommy Choi",
      "email": "manychois@manychois.com.au"
    }
  ],
  "keywords": [
    "template"
  ],
  "require": {
    "php": "^8.4",
    "ext-dom": "*"
  },
  "require-dev": {
    "escapestudios/symfony2-coding-standard": "^3.15",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^11.5",
    "slevomat/coding-standard": "^8.15",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "Manychois\\Views\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Manychois\\ViewTests\\IntegrationTests\\": "tests/integration-tests/",
      "Manychois\\ViewTests\\UnitTests\\": "tests/unit-tests/"
    }
  },
  "scripts": {
    "test": [
      "@putenv XDEBUG_MODE=coverage",
      "phpunit"
    ],
    "phpcs": "phpcs --standard=phpcs.xml -s",
    "phpcbf": "phpcbf --standard=phpcs.xml || true",
    "phpstan": "phpstan analyse -c phpstan.dist.neon || true",
    "code": [
      "@phpcbf",
      "@phpcs",
      "@phpstan"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
